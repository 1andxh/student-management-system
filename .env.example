ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://sms:sms@localhost:5435/sms
DATABASE_URL_TEST=postgresql+asyncpg://sms:sms@localhost:5436/sms_test

JWT_SECRET_KEY=change-me-in-.env-only
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Secure flag on the refresh-token cookie (docs/adr/0027). Leave true;
# Chrome/Firefox accept Secure cookies on http://127.0.0.1.
REFRESH_COOKIE_SECURE=true
# Browser origins allowed to call the API with credentials. JSON list; "*" is rejected.
CORS_ORIGINS=["http://127.0.0.1:5173"]

UPLOAD_DIR=uploads
